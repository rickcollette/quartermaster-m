{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuarterMaster-M",
  "version": "1.0.33",
  "identifier": "org.rootsh.quartermaster-m",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splashscreen",
        "title": "QuarterMaster/M",
        "url": "splashscreen.html",
        "width": 711,
        "height": 438,
        "center": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "focus": true,
        "visible": true
      },
      {
        "label": "main",
        "title": "QuarterMaster/M \u2014 ATASCII Editor",
        "width": 1040,
        "height": 820,
        "minWidth": 720,
        "minHeight": 620,
        "resizable": true,
        "visible": false,
        "focus": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "A 40-column ATASCII editor",
    "longDescription": "QuarterMaster/M is a blue, white, and inverse Atari-style ATASCII text and screen editor.",
    "copyright": "Copyright 2026 Rick Collette",
    "icon": [
      "icons/favicon-32x32.png",
      "icons/android-chrome-192x192.png",
      "icons/android-chrome-512x512.png",
      "icons/favicon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
